<!DOCTYPE html>
<html>
<head>
    <title>Contactos Administrador</title>
    <script>
        function searchContacts() {
            let input = document.getElementById('search').value.toLowerCase();
            let table = document.getElementById('adminContactsTable');
            let tr = table.getElementsByTagName('tr');
            for (let i = 1; i < tr.length; i++) {
                let tdName = tr[i].getElementsByTagName('td')[0];
                let tdEmail = tr[i].getElementsByTagName('td')[1];
                if (tdName || tdEmail) {
                    let nameValue = tdName.textContent || tdName.innerText;
                    let emailValue = tdEmail.textContent || tdEmail.innerText;
                    if (nameValue.toLowerCase().indexOf(input) > -1 || emailValue.toLowerCase().indexOf(input) > -1) {
                        tr[i].style.display = '';
                    } else {
                        tr[i].style.display = 'none';
                    }
                }
            }
        }
    </script>
</head>
<body>
    <h1>Contactos Administrador</h1>
    <input type="text" id="search" onkeyup="searchContacts()" placeholder="Buscar por nombre o email...">
    <table id="adminContactsTable" border="1">
        <thead>
            <tr>
                <th>Nombre</th>
                <th>Email</th>
                <th>Comentario</th>
                <th>IP</th>
                <th>País</th>
                <th>Fecha</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            <% contactos.forEach(contacto => { %>
                <tr>
                    <td><%= contacto.nombre %></td>
                    <td><%= contacto.email %></td>
                    <td><%= contacto.comentario %></td>
                    <td><%= contacto.ip %></td>
                    <td><%= contacto.pais %></td>
                    <td><%= contacto.fecha %></td>
                    <td>
                        <a href="/admin/contactos/editar/<%= contacto.id %>">Editar</a> |
                        <a href="/admin/contactos/eliminar/<%= contacto.id %>">Eliminar</a>
                    </td>
                </tr>
            <% }) %>
        </tbody>
    </table>
</body>
</html>
