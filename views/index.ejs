<!DOCTYPE html>
<html lang="es">

<head>
    <%- include('partials/head', { includeRecaptcha: true }) %>
</head>

<body>

    <%- include('partials/header') %>

        <main role="main">
            <!-- HERO SECTION -->
            <section id="hero">
                <div class="hero-content">
                    <span class="badge-neon">TALLER CERTIFICADO</span>
                    <h1>Ingeniería Automotriz <br> <span class="text-gradient">De Alto Nivel</span></h1>
                    <p>Especialistas en mecánica de precisión, tuning de alto rendimiento y mantenimiento preventivo. Tu
                        vehículo merece el mejor trato de Los Santos.</p>
                    <div class="hero-buttons">
                        <button id="contactButton" onclick="openModal()" class="btn-primary">Agendar Cita</button>
                        <button onclick="location.href='#servicios'" class="btn-outline">Nuestros Servicios</button>
                    </div>
                </div>
                <div class="hero-overlay"></div>
            </section>

            <!-- STATS SECTION -->
            <section id="stats">
                <div class="container stats-grid">
                    <div class="stat-item">
                        <span class="stat-number" data-target="20">0</span>
                        <span class="stat-label">Años de Experiencia</span>
                    </div>
                    <div class="stat-item">
                        <span class="stat-number" data-target="5000">0</span>
                        <span class="stat-label">Vehículos Reparados</span>
                    </div>
                    <div class="stat-item">
                        <span class="stat-number" data-target="100">0</span>
                        <span class="stat-label">% Satisfacción</span>
                    </div>
                    <div class="stat-item">
                        <span class="stat-number" data-target="15">0</span>
                        <span class="stat-label">Expertos Certificados</span>
                    </div>
                </div>
            </section>

            <!-- SERVICES PREVIEW -->
            <section id="servicios" class="section-padding">
                <div class="container">
                    <div class="section-header">
                        <h2>Soluciones Integrales</h2>
                        <p>Mantenimiento preventivo, correctivo y performance para tu automóvil.</p>
                    </div>
                    <div class="servicios-grid">
                        <div class="carta" onclick="location.href='/maintenance'">
                            <div class="carta-image">
                                <img src="images/Maintenance.jpg" alt="Mantenimiento Preventivo">
                                <div class="carta-overlay"></div>
                            </div>
                            <div class="carta-content">
                                <h3>Mantenimiento</h3>
                                <p>Cambio de aceite, filtros y revisión general para prolongar la vida de tu motor.</p>
                                <span class="link-arrow">Ver detalles &rarr;</span>
                            </div>
                        </div>
                        <div class="carta" onclick="location.href='/repairs'">
                            <div class="carta-image">
                                <img src="images/Repairs.jpg" alt="Reparaciones Mecánicas">
                                <div class="carta-overlay"></div>
                            </div>
                            <div class="carta-content">
                                <h3>Reparaciones</h3>
                                <p>Diagnóstico computarizado y reparación de fallas complejas en motor y transmisión.
                                </p>
                                <span class="link-arrow">Ver detalles &rarr;</span>
                            </div>
                        </div>
                        <div class="carta" onclick="location.href='/tires'">
                            <div class="carta-image">
                                <img src="images/Tires.jpg" alt="Servicio de Neumáticos">
                                <div class="carta-overlay"></div>
                            </div>
                            <div class="carta-content">
                                <h3>Neumáticos</h3>
                                <p>Alineación 3D, balanceo y venta de neumáticos de alto rendimiento.</p>
                                <span class="link-arrow">Ver detalles &rarr;</span>
                            </div>
                        </div>
                    </div>
                </div>
            </section>

            <!-- PROCESS SECTION -->
            <section id="process" class="section-dark">
                <div class="container">
                    <div class="section-header">
                        <h2>Nuestro Proceso</h2>
                        <p>Transparencia y profesionalismo en cada paso.</p>
                    </div>
                    <div class="process-steps">
                        <div class="step">
                            <div class="step-icon">01</div>
                            <h3>Diagnóstico</h3>
                            <p>Evaluación digital completa para identificar el problema real.</p>
                        </div>
                        <div class="step">
                            <div class="step-icon">02</div>
                            <h3>Presupuesto</h3>
                            <p>Cotización detallada y transparente sin costos ocultos.</p>
                        </div>
                        <div class="step">
                            <div class="step-icon">03</div>
                            <h3>Reparación</h3>
                            <p>Ejecución por técnicos certificados usando repuestos originales.</p>
                        </div>
                        <div class="step">
                            <div class="step-icon">04</div>
                            <h3>Entrega</h3>
                            <p>Tu vehículo listo, probado y garantizado.</p>
                        </div>
                    </div>
                </div>
            </section>

            <!-- ABOUT PREVIEW -->
            <section id="about-preview">
                <div class="container split-layout">
                    <div class="image-wrapper">
                        <img src="images/Losherma.jpg" alt="Equipo Los Santos">
                        <div class="experience-badge">
                            <span class="years">20+</span>
                            <span class="text">Años de<br>Calidad</span>
                        </div>
                    </div>
                    <div class="text-content">
                        <h2>La Excelencia es Nuestra Norma</h2>
                        <p>
                            Desde nuestros inicios en Cagua, nos hemos dedicado a elevar el estándar de la mecánica
                            automotriz.
                            No somos solo un taller; somos un centro de ingeniería automotriz donde la pasión se
                            encuentra con la precisión.
                        </p>
                        <ul class="feature-list">
                            <li>✅ Garantía certificada en mano de obra</li>
                            <li>✅ Repuestos OEM y de alto rendimiento</li>
                            <li>✅ Sala de espera VIP con WiFi</li>
                        </ul>
                        <button onclick="location.href='/about'" class="btn-outline">Conoce nuestra historia</button>
                    </div>
                </div>
            </section>

            <!-- TESTIMONIALS -->
            <section id="testimonials" class="section-padding">
                <div class="container">
                    <div class="section-header">
                        <h2>Lo que dicen nuestros clientes</h2>
                    </div>
                    <div class="testimonials-grid">
                        <div class="testimonial-card">
                            <p class="quote">"El mejor servicio de tuning en la ciudad. Transformaron mi coche por
                                completo. La atención al detalle es increíble."</p>
                            <div class="author">
                                <div class="avatar">JM</div>
                                <div class="info">
                                    <strong>Juan Martínez</strong>
                                    <span>Cliente VIP</span>
                                </div>
                            </div>
                        </div>
                        <div class="testimonial-card">
                            <p class="quote">"Rapidez y honestidad. Me explicaron todo el proceso y el precio fue justo.
                                Totalmente recomendados."</p>
                            <div class="author">
                                <div class="avatar">AR</div>
                                <div class="info">
                                    <strong>Ana Rodríguez</strong>
                                    <span>Cliente Frecuente</span>
                                </div>
                            </div>
                        </div>
                        <div class="testimonial-card">
                            <p class="quote">"Me salvaron de una reparación costosa que otro taller diagnosticó mal.
                                Profesionales de verdad."</p>
                            <div class="author">
                                <div class="avatar">CP</div>
                                <div class="info">
                                    <strong>Carlos Pérez</strong>
                                    <span>Entusiasta de Autos</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </section>

            <!-- FAQ SECTION -->
            <section id="faq" class="section-dark">
                <div class="container">
                    <div class="section-header">
                        <h2>Preguntas Frecuentes</h2>
                    </div>
                    <div class="faq-container">
                        <div class="faq-item">
                            <button class="faq-question">¿Qué métodos de pago aceptan? <span
                                    class="arrow">+</span></button>
                            <div class="faq-answer">
                                <p>Aceptamos tarjetas de crédito, débito, transferencias bancarias y efectivo. También
                                    ofrecemos planes de financiamiento para reparaciones mayores.</p>
                            </div>
                        </div>
                        <div class="faq-item">
                            <button class="faq-question">¿Tienen garantía sus reparaciones? <span
                                    class="arrow">+</span></button>
                            <div class="faq-answer">
                                <p>Sí, todas nuestras reparaciones cuentan con una garantía de 6 meses o 10,000 km, lo
                                    que ocurra primero, en mano de obra y repuestos suministrados por nosotros.</p>
                            </div>
                        </div>
                        <div class="faq-item">
                            <button class="faq-question">¿Necesito cita previa? <span class="arrow">+</span></button>
                            <div class="faq-answer">
                                <p>Recomendamos agendar cita para garantizar la atención inmediata, pero también
                                    atendemos emergencias y walk-ins según disponibilidad.</p>
                            </div>
                        </div>
                    </div>
                </div>
            </section>

            <!-- BRANDS SECTION -->
            <section class="brands-section">
                <div class="container">
                    <p style="text-align: center; color: var(--text-muted); margin-bottom: var(--spacing-md);">
                        Trabajamos con las mejores marcas</p>
                    <div class="brands-track">
                        <span style="font-size: 1.5rem; font-weight: bold;">MICHELIN</span>
                        <span style="font-size: 1.5rem; font-weight: bold;">MOBIL 1</span>
                        <span style="font-size: 1.5rem; font-weight: bold;">BOSCH</span>
                        <span style="font-size: 1.5rem; font-weight: bold;">PIRELLI</span>
                        <span style="font-size: 1.5rem; font-weight: bold;">NGK</span>
                        <span style="font-size: 1.5rem; font-weight: bold;">CASTROL</span>
                    </div>
                </div>
            </section>

            <!-- CTA BANNER -->
            <section id="cta-banner">
                <div class="container">
                    <h2>¿Listo para llevar tu auto al siguiente nivel?</h2>
                    <p>No esperes a que falle. Agenda tu diagnóstico hoy mismo.</p>
                    <div class="cta-buttons">
                        <button onclick="openModal()" class="btn-primary">Agendar Ahora</button>
                        <button onclick="location.href='https://wa.me/123456789'" class="btn-outline">WhatsApp
                            Directo</button>
                    </div>
                </div>
            </section>

            <%- include('partials/footer') %>

                <!-- Modal de Contacto -->
                <div id="contactModal" class="modal">
                    <div class="modal-content">
                        <span class="close-button" onclick="closeModal()">&times;</span>
                        <h2>Contáctanos</h2>
                        <form id="contactForm" action="/contact" method="POST" onsubmit="return handleSubmit(event)">
                            <label for="name">Nombre:</label>
                            <input type="text" id="name" name="nombre" placeholder="Escribe tu nombre" required><br>
                            <label for="email">Correo electrónico:</label>
                            <input type="email" id="email" name="email" placeholder="Escribe tu correo electrónico"
                                required><br>
                            <label for="message">Mensaje:</label>
                            <textarea id="message" name="comentario" placeholder="Escribe tu mensaje"
                                required></textarea><br>
                            <!-- Widget de reCAPTCHA -->
                            <div class="g-recaptcha" data-sitekey="6LdELq8qAAAAAMyxoN3WRlC2PghCmnXcBUc5V34V"></div>
                            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                            <button type="submit">Enviar</button>
                        </form>
                        <div id="confirmationMessage" class="confirmation-message" aria-live="polite">
                            ¡Gracias por contactarnos! Nos pondremos en contacto contigo pronto.
                        </div>
                    </div>
                </div>

                <%- include('partials/scripts') %>
</body>

</html>