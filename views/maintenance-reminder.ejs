<!DOCTYPE html>
<html lang="es">

<head>
    <%- include('partials/head', { title: 'Recordatorio de Mantenimiento' }) %>
        <!-- Usamos el mismo estilo de formulario que en calculator -->
        <style>
            .reminder-card {
                background: var(--bg-tertiary);
                padding: var(--spacing-lg);
                border-radius: var(--radius-lg);
                border: 1px solid var(--border-dark);
                max-width: 600px;
                margin: 0 auto;
                text-align: center;
            }

            .bell-icon {
                font-size: 4rem;
                margin-bottom: var(--spacing-md);
                animation: ring 2s infinite ease-in-out;
                display: inline-block;
            }

            @keyframes ring {
                0% {
                    transform: rotate(0);
                }

                10% {
                    transform: rotate(15deg);
                }

                20% {
                    transform: rotate(-15deg);
                }

                30% {
                    transform: rotate(10deg);
                }

                40% {
                    transform: rotate(-10deg);
                }

                50% {
                    transform: rotate(0);
                }
            }
        </style>
</head>

<body>
    <%- include('partials/header') %>

        <main role="main">
            <section class="section-dark" style="padding-top: 100px; text-align: center;">
                <div class="container">
                    <span class="badge-neon">Asistente Personal</span>
                    <h1>Recordatorio de <span class="text-gradient">Mantenimiento</span></h1>
                    <p>Nunca más olvides un cambio de aceite. Nosotros te avisamos.</p>
                </div>
            </section>

            <section class="section-padding">
                <div class="container">
                    <div class="reminder-card">
                        <div class="bell-icon">🔔</div>
                        <h2>Activar Alertas</h2>
                        <p style="margin-bottom: var(--spacing-lg);">
                            Ingresa los datos de tu último servicio y te enviaremos un recordatorio por correo
                            electrónico cuando sea momento de volver.
                        </p>

                        <form id="reminderForm">
                            <div class="form-group">
                                <input type="text" placeholder="Tu Nombre" required>
                            </div>
                            <div class="form-group">
                                <input type="email" placeholder="Tu Email" required>
                            </div>
                            <div class="form-group">
                                <label
                                    style="display:block; text-align:left; color:var(--text-secondary); margin-bottom:5px;">Fecha
                                    del último servicio</label>
                                <input type="date" required>
                            </div>
                            <div class="form-group">
                                <select>
                                    <option>Aceite Mineral (5,000 km / 3 meses)</option>
                                    <option>Aceite Semi-Sintético (7,000 km / 4 meses)</option>
                                    <option>Aceite Sintético (10,000 km / 6 meses)</option>
                                </select>
                            </div>
                            <button type="submit" class="btn-primary" style="width: 100%;">Programar Alerta</button>
                        </form>
                    </div>
                </div>
            </section>
        </main>

        <%- include('partials/footer') %>
            <%- include('partials/scripts') %>

                <script>
                    document.getElementById('reminderForm').addEventListener('submit', function (e) {
                        e.preventDefault();
                        alert('¡Recordatorio programado! Te avisaremos cuando se acerque la fecha.');
                        this.reset();
                    });
                </script>
</body>

</html>