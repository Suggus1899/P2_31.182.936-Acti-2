<!DOCTYPE html>
<html lang="es">

<head>
    <%- include('partials/head', { title: 'Reparaciones Mecánicas' }) %>
</head>

<body>
    <%- include('partials/header') %>

        <main role="main">
            <section class="section-dark" style="text-align: center; padding-top: 100px;">
                <div class="container">
                    <span class="badge-neon">Diagnóstico Preciso</span>
                    <h1>Reparación <span class="text-gradient">Avanzada</span></h1>
                    <p style="max-width: 700px; margin: 0 auto;">
                        Desde reconstrucción de motores hasta fallas eléctricas complejas. Si otros no pueden
                        arreglarlo, nosotros sí.
                    </p>
                </div>
            </section>

            <!-- SERVICES GRID (Using the existing services grid style but for repair types) -->
            <section class="section-padding">
                <div class="container">
                    <div class="servicios-grid">
                        <div class="carta">
                            <div class="carta-image">
                                <!-- Using generic or existing images -->
                                <img src="images/Repairs.jpg" alt="Motor">
                            </div>
                            <div class="carta-content">
                                <h3>Motor y Transmisión</h3>
                                <p>Reconstrucción, empaquetaduras, sincronización y diagnóstico de caja de cambios.</p>
                            </div>
                        </div>
                        <div class="carta">
                            <div class="carta-image">
                                <!-- Potentially reuse images or placeholders as user didn't provide many -->
                                <img src="images/Maintenance.jpg" alt="Frenos">
                            </div>
                            <div class="carta-content">
                                <h3>Frenos y Suspensión</h3>
                                <p>Rectificación de discos, ABS, amortiguadores y tren delantero.</p>
                            </div>
                        </div>
                        <div class="carta">
                            <div class="carta-image">
                                <img src="images/Tires.jpg" alt="Electricidad">
                            </div>
                            <div class="carta-content">
                                <h3>Electricidad</h3>
                                <p>Alternadores, arranque, cableado, luces LED y sistemas de sonido.</p>
                            </div>
                        </div>
                    </div>
                </div>
            </section>

            <section id="cta-banner">
                <div class="container">
                    <h2>¿Ruidos extraños? ¿Luces en el tablero?</h2>
                    <p>Trae tu vehículo para un escaneo computarizado gratuito con cualquier reparación mayor.</p>
                    <div class="cta-buttons">
                        <button onclick="openModal()" class="btn-primary">Diagnosticar Ahora</button>
                    </div>
                </div>
            </section>
        </main>

        <%- include('partials/footer') %>
            <%- include('partials/scripts') %>
</body>

</html>