<!DOCTYPE html>
<html lang="es">

<head>
    <%- include('partials/head', { title: 'Tienda de Accesorios' }) %>
        <style>
            .product-card {
                background: var(--bg-tertiary);
                border-radius: var(--radius-md);
                border: 1px solid var(--border-dark);
                overflow: hidden;
                transition: transform 0.3s ease;
            }

            .product-card:hover {
                transform: translateY(-5px);
                border-color: var(--color-accent);
            }

            .product-img {
                width: 100%;
                height: 200px;
                object-fit: cover;
            }

            .product-info {
                padding: var(--spacing-md);
            }

            .product-price {
                font-size: 1.25rem;
                color: var(--color-primary);
                font-weight: bold;
                margin: 10px 0;
            }

            .btn-cart {
                width: 100%;
                background: var(--bg-secondary);
                border: 1px solid white;
                color: white;
                padding: 10px;
                cursor: pointer;
            }

            .btn-cart:hover {
                background: white;
                color: black;
            }
        </style>
</head>

<body>
    <%- include('partials/header') %>

        <main role="main">
            <section class="section-dark" style="padding-top: 100px; text-align: center;">
                <div class="container">
                    <span class="badge-neon">Lifestyle</span>
                    <h1>Tienda de <span class="text-gradient">Accesorios</span></h1>
                    <p>Equipa tu auto y tu estilo con nuestra colección exclusiva.</p>
                </div>
            </section>

            <section class="section-padding">
                <div class="container">
                    <div class="grid"
                        style="display: grid; grid-template-columns: repeat(auto-fill, minmax(250px, 1fr)); gap: 30px;">

                        <!-- Product 1 -->
                        <div class="product-card">
                            <div
                                style="background:#333; height:200px; display:flex; align-items:center; justify-content:center;">
                                🧢</div>
                            <div class="product-info">
                                <h3>Gorra Los Santos Snapback</h3>
                                <div class="product-price">$25.00</div>
                                <button class="btn-cart">Añadir al Carrito</button>
                            </div>
                        </div>

                        <!-- Product 2 -->
                        <div class="product-card">
                            <div
                                style="background:#333; height:200px; display:flex; align-items:center; justify-content:center;">
                                👕</div>
                            <div class="product-info">
                                <h3>Franela Team Mechanic</h3>
                                <div class="product-price">$30.00</div>
                                <button class="btn-cart">Añadir al Carrito</button>
                            </div>
                        </div>

                        <!-- Product 3 -->
                        <div class="product-card">
                            <div
                                style="background:#333; height:200px; display:flex; align-items:center; justify-content:center;">
                                🔑</div>
                            <div class="product-info">
                                <h3>Llavero Turbo Metálico</h3>
                                <div class="product-price">$15.00</div>
                                <button class="btn-cart">Añadir al Carrito</button>
                            </div>
                        </div>

                        <!-- Product 4 -->
                        <div class="product-card">
                            <div
                                style="background:#333; height:200px; display:flex; align-items:center; justify-content:center;">
                                🧴</div>
                            <div class="product-info">
                                <h3>Kit de Limpieza Premium</h3>
                                <div class="product-price">$45.00</div>
                                <button class="btn-cart">Añadir al Carrito</button>
                            </div>
                        </div>

                    </div>
                </div>
            </section>
        </main>

        <%- include('partials/footer') %>
            <%- include('partials/scripts') %>
</body>

</html>