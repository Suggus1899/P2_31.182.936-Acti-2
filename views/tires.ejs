<!DOCTYPE html>
<html lang="es">

<head>
    <%- include('partials/head', { title: title || 'Servicio de Neumáticos' }) %>
</head>

<body>
    <%- include('partials/header') %>

        <main role="main">
            <section class="section-dark" style="text-align: center; padding-top: 100px;">
                <div class="container">
                    <span class="badge-neon">Seguridad Vial</span>
                    <h1>Neumáticos & <span class="text-gradient">Alineación</span></h1>
                    <p style="max-width: 700px; margin: 0 auto;">
                        El único punto de contacto entre tu auto y la carretera. Asegura el máximo agarre y estabilidad.
                    </p>
                </div>
            </section>

            <!-- PRICING/PACKAGES FOR TIRES -->
            <section class="section-padding">
                <div class="container">
                    <div class="pricing-grid">
                        <div class="pricing-card">
                            <h3>Alineación 3D</h3>
                            <div class="price">$40</div>
                            <p>Para automóviles sedan y hatchback.</p>
                            <ul class="features-list">
                                <li>✅ Alineación Computarizada</li>
                                <li>✅ Revisión de Tren Delantero</li>
                                <li>✅ Informe de Estado</li>
                            </ul>
                            <button onclick="openModal()" class="btn-outline" style="width: 100%;">Agendar</button>
                        </div>

                        <div class="pricing-card featured">
                            <div class="pricing-badge">COMBO</div>
                            <h3>Balanceo + Alineación</h3>
                            <div class="price">$60</div>
                            <p>Mantenimiento completo de rodaje.</p>
                            <ul class="features-list">
                                <li>✅ Alineación 3D</li>
                                <li>✅ Balanceo de 4 Ruedas</li>
                                <li>✅ Rotación de Neumáticos</li>
                                <li>✅ Calibración de Aire/Nitrógeno</li>
                            </ul>
                            <button onclick="openModal()" class="btn-primary" style="width: 100%;">Agendar</button>
                        </div>

                        <div class="pricing-card">
                            <h3>Camionetas/SUV</h3>
                            <div class="price">$80</div>
                            <p>Para vehículos de gran tamaño.</p>
                            <ul class="features-list">
                                <li>✅ Alineación Reforzada</li>
                                <li>✅ Balanceo Dinámico</li>
                                <li>✅ Revisión de Suspensión 4x4</li>
                            </ul>
                            <button onclick="openModal()" class="btn-outline" style="width: 100%;">Agendar</button>
                        </div>
                    </div>
                </div>
            </section>

            <section class="section-dark">
                <div class="container split-layout">
                    <div class="text-content">
                        <h2>Distribuidor Oficial</h2>
                        <p>
                            Contamos con stock permanente de las mejores marcas del mercado: Michelin, Pirelli,
                            Bridgestone y Goodyear.
                        </p>
                        <ul class="feature-list">
                            <li>✅ Montaje gratuito con la compra de 4 neumáticos</li>
                            <li>✅ Garantía de 5 años por defectos de fabricación</li>
                            <li>✅ Reparación de pinchazos de por vida</li>
                        </ul>
                    </div>
                    <div class="image-wrapper">
                        <img src="images/Tires.jpg" alt="Neumáticos Nuevos">
                    </div>
                </div>
            </section>
        </main>

        <%- include('partials/footer') %>
            <%- include('partials/scripts') %>
</body>

</html>